---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../utils/i18n';
import { socialNetworks } from '../data/portfolio';
import ContactForm from '../components/ContactForm';
import { IconBrandLinkedin, IconBrandGithub, IconBrandInstagram, IconAt } from '@tabler/icons-react';

const lang = 'es';
const t = useTranslations(lang);

const iconMap: Record<string, any> = {
  'LinkedIn': IconBrandLinkedin,
  'GitHub': IconBrandGithub,
  'Instagram': IconBrandInstagram,
  'Email': IconAt,
};
---

<Layout
  title="Contacto - Benjamín García"
  description="Ponte en contacto para conversar sobre tu próximo proyecto. Desarrollo web Full-Stack y consultoría técnica."
  lang={lang}
>
  <!-- Hero -->
  <section class="section-container pt-24 pb-12">
    <div class="max-w-2xl mx-auto text-center animate-on-scroll">
      <!-- Profile Image -->
      <div class="mb-8">
        <img
          src="/img/benjamngarcia.png"
          alt="Benjamín García"
          class="w-32 h-32 rounded-full mx-auto object-cover border-4 border-gray-200 dark:border-gray-800 shadow-lg"
        />
      </div>

      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Benjamín García
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
        Full-Stack Developer • JavaScript • TypeScript • React
      </p>
    </div>
  </section>

  <!-- Contact Links - Linktree Style -->
  <section class="section-container py-0">
    <div class="max-w-2xl mx-auto space-y-4 animate-on-scroll">
      {socialNetworks.map((social) => {
        const Icon = iconMap[social.name];
        return (
          <a
            href={social.link}
            target={social.name !== 'Email' ? '_blank' : undefined}
            rel={social.name !== 'Email' ? 'noopener noreferrer' : undefined}
            class="flex items-center justify-between p-6 bg-white dark:bg-gray-900 rounded-2xl border-2 border-gray-200 dark:border-gray-800 hover:border-accent-500 dark:hover:border-accent-500 hover:shadow-lg transition-all group"
          >
            <div class="flex items-center gap-4">
              <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-accent-100 dark:bg-accent-900 text-accent-600 dark:text-accent-400 group-hover:scale-110 transition-transform">
                <Icon size={28} />
              </div>
              <div class="text-left">
                <div class="font-bold text-lg text-gray-900 dark:text-white">
                  {social.name}
                </div>
                <div class="text-sm text-gray-600 dark:text-gray-400">
                  {social.descriptionEs}
                </div>
              </div>
            </div>
            <svg class="w-6 h-6 text-gray-400 group-hover:text-accent-500 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        );
      })}

      <!-- Email Button (Primary) -->
      <a
        href="mailto:benjamngarcia@outlook.com"
        class="flex items-center justify-between p-6 bg-accent-500 hover:bg-accent-600 rounded-2xl shadow-lg hover:shadow-xl transition-all group"
      >
        <div class="flex items-center gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-white/20 text-white group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div class="text-left">
            <div class="font-bold text-lg text-white">
              Envíame un Email
            </div>
            <div class="text-sm text-white/80">
              benjamngarcia@outlook.com
            </div>
          </div>
        </div>
        <svg class="w-6 h-6 text-white group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Footer Note -->
  <section class="section-container pt-8 pb-16">
    <div class="max-w-2xl mx-auto text-center animate-on-scroll">
      <div class="card p-6 bg-accent-50 dark:bg-accent-900/20">
        <div class="flex items-center justify-center gap-2 text-accent-600 dark:text-accent-400 font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Disponible para nuevos proyectos</span>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
          Generalmente respondo en menos de 24 horas
        </p>
      </div>
    </div>
  </section>
</Layout>
